# Text is stored LF, so Windows checkouts don't churn line endings. Binaries are named
# explicitly: git's own binary test reads only the first 8,000 bytes, and a binary it takes
# for text is rewritten by a Windows checkout. repo-standards' eol-check enforces both.
* text=auto eol=lf

# images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary
*.heic binary
*.psd binary
*.ai binary
